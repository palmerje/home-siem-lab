# Custom Suricata rule — vsftpd 2.3.4 backdoor "smiley" login detection
# Author: Jearld Palmer | Home SIEM Lab (Security Onion 2.4)
# CVE-2011-2523 | MITRE ATT&CK T1190 (Exploit Public-Facing Application)
# Detects the FTP USER command carrying the ":)" backdoor trigger (|3a 29| = ":)").
# Scoped $HOME_NET -> $HOME_NET for a flat/isolated lab; a production analog would
# typically use $EXTERNAL_NET -> $HOME_NET. Fires on the attempt, success or not.

alert tcp $HOME_NET any -> $HOME_NET 21 (msg:"LOCAL vsftpd 2.3.4 Backdoor Smiley Login (CVE-2011-2523, T1190)"; flow:established,to_server; content:"USER "; nocase; content:"|3a 29|"; distance:0; classtype:attempted-admin; sid:1000002; rev:1;)
